---
import MainLayout from '../layouts/main.astro';
import { getCollection } from 'astro:content';

const projectsData = (await getCollection('projects')).map((entry) => entry.data);
---

<MainLayout 
	title="Projects — Lit Phansiri" 
	description="Selected data science, AI, and full-stack projects from Capt Lit Phansiri."
>
	<section class="hero-grid border-b border-border">
		<div class="container mx-auto px-4 py-20">
			<div class="max-w-3xl">
				<h1 class="font-display text-4xl md:text-6xl font-bold mb-4">Projects</h1>
				<p class="text-lg text-muted-foreground max-w-2xl leading-relaxed">
					Builds across generative AI, data systems, and full-stack delivery — selected for impact, not volume.
				</p>
			</div>
		</div>
	</section>

	<section class="container mx-auto px-4 py-16">
		<div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
			{projectsData.map((project) => (
				<article class="pixel-panel flex flex-col overflow-hidden">
					<div class="aspect-video bg-muted border-b border-border flex items-center justify-center overflow-hidden">
						{project.visual ? (
							<img 
								src={project.visual} 
								alt={project.title} 
								class="w-full h-full object-contain project-image" 
								loading="lazy"
								decoding="async"
							/>
						) : (
							<p class="text-sm text-muted-foreground font-display">No visual</p>
						)}
					</div>
					<div class="p-5 flex flex-col flex-1">
						<div class="flex justify-between items-start gap-3 mb-2">
							<h2 class="font-display text-lg font-semibold leading-snug">{project.title}</h2>
							<span class="pixel-tag shrink-0 border-gold text-gold">{project.year}</span>
						</div>
						<p class="text-sm text-primary font-medium mb-2">{project.impact}</p>
						<p class="text-sm text-muted-foreground mb-4 line-clamp-3 flex-1">{project.summary}</p>
						<div class="flex flex-wrap gap-1 mb-4">
							{project.tech?.slice(0, 4).map((tech) => (
								<span class="pixel-tag">{tech}</span>
							))}
							{project.tech && project.tech.length > 4 && (
								<span class="pixel-tag">+{project.tech.length - 4}</span>
							)}
						</div>
						<a href={project.link} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm btn-block cta-scan">
							View Project
						</a>
					</div>
				</article>
			))}
		</div>
	</section>

	<section class="container mx-auto px-4 pb-20">
		<div class="max-w-3xl border border-border bg-card p-8">
			<h2 class="font-display text-2xl font-bold mb-3">Collaborate</h2>
			<p class="text-muted-foreground mb-6">
				Looking for someone who can own the technical work end to end? Let's talk.
			</p>
			<div class="flex flex-col sm:flex-row gap-3">
				<a href="/contact" class="btn btn-primary btn-lg cta-scan">Start a Project</a>
				<a href="https://github.com/phansiri" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-lg">
					GitHub
				</a>
			</div>
		</div>
	</section>
</MainLayout>
