---
import MainLayout from '../layouts/main.astro';
import { siteConfig } from '../lib/config';

const destinations = [
	{ name: 'About', href: '/about', blurb: 'Service, Berkeley, and the work' },
	{ name: 'Blog', href: '/blog', blurb: 'Notes on AI systems and SI' },
	{ name: 'Projects', href: '/projects', blurb: 'Selected builds and experiments' },
	{ name: 'Experiences', href: '/experiences', blurb: 'Command and technical tour' },
	{ name: 'Education', href: '/education', blurb: 'MIDS and continuous training' },
	{ name: 'Contact', href: '/contact', blurb: 'Reach out via LinkedIn' },
];
---

<MainLayout 
	title={`${siteConfig.author.name} — Capt, USMC · Data Scientist`} 
	description={siteConfig.description}
>
	<!-- Hero: one composition -->
	<section class="hero-grid border-b border-border">
		<div class="container mx-auto px-4 min-h-[calc(100vh-4rem)] flex flex-col justify-center py-20">
			<div class="max-w-3xl">
				<p class="text-xs tracking-[0.2em] uppercase text-gold mb-6 brand-mark">
					Capt · O-3E · USMC
				</p>
				<h1 class="font-display text-5xl md:text-7xl font-bold text-foreground mb-6 leading-[1.05]">
					{siteConfig.author.name}
				</h1>
				<p class="text-lg md:text-xl text-muted-foreground max-w-2xl mb-10 leading-relaxed">
					Marine Corps Officer and UC Berkeley data scientist building AI systems —
					and thinking hard about what comes after.
				</p>
				<div class="flex flex-col sm:flex-row gap-3">
					<a href="/blog" class="btn btn-primary btn-lg cta-scan">Read the Blog</a>
					<a href="/contact" class="btn btn-outline btn-lg">Make Contact</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Destination strip -->
	<section class="container mx-auto px-4 py-16">
		<div class="max-w-3xl">
			<div class="pixel-rule mb-8"></div>
			<p class="font-display text-sm tracking-widest uppercase text-muted-foreground mb-6">Navigate</p>
			<ul class="border border-border divide-y divide-border">
				{destinations.map((item) => (
					<li>
						<a
							href={item.href}
							class="group flex items-baseline justify-between gap-4 px-4 py-4 hover:bg-card hover:border-l-2 hover:border-l-primary transition-colors"
						>
							<span class="font-display text-lg text-foreground group-hover:text-primary transition-colors">
								{item.name}
							</span>
							<span class="text-sm text-muted-foreground text-right">{item.blurb}</span>
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>
</MainLayout>
