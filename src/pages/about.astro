---
import MainLayout from '../layouts/main.astro';
import RankTrail from '../components/RankTrail.astro';
import { getCollection } from 'astro:content';

const skillsData = (await getCollection('skills')).map((entry) => entry.data);

const milestones = [
	{ year: '2027+', text: 'Launching an AI startup — agents that solve real problems for real organizations.' },
	{ year: '2027', text: 'Retiring from the Marine Corps after 24+ years of service.' },
	{ year: '2025', text: 'Graduated UC Berkeley MIDS; focused on generative AI systems.' },
	{ year: '2020', text: 'Led AI-driven cyber operations at Marine Forces Cyber Command.' },
	{ year: '2017', text: 'Became one of the first Cyberspace Warfare Officers in the USMC.' },
	{ year: '2003', text: 'Enlisted in the Marine Corps.' },
];
---

<MainLayout 
	title="About — Lit Phansiri" 
	description="Capt Lit Phansiri: U.S. Marine Corps Officer, UC Berkeley data scientist, building AI systems."
>
	<section class="hero-grid border-b border-border">
		<div class="container mx-auto px-4 py-20">
			<div class="max-w-3xl">
				<h1 class="font-display text-4xl md:text-6xl font-bold mb-4">About</h1>
				<p class="text-lg text-muted-foreground max-w-2xl leading-relaxed mb-8">
					Captain (O-3E), U.S. Marine Corps. UC Berkeley MIDS. Building AI systems with the same discipline the Corps taught me.
				</p>
				<div class="w-28 h-28 border-2 border-primary overflow-hidden bg-card">
					<img 
						src="/portfolio/lit_profile.png" 
						alt="Lit Phansiri" 
						class="w-full h-full object-cover"
					/>
				</div>
			</div>
		</div>
	</section>

	<section class="container mx-auto px-4 py-16">
		<div class="max-w-3xl">
			<h2 class="font-display text-2xl font-bold mb-6">Story</h2>
			<div class="space-y-4 text-muted-foreground leading-relaxed">
				<p>
					As an Active Duty U.S. Marine and UC Berkeley-trained data scientist, I bring military
					discipline and technical depth to every system I build. The work spans from serving the
					country to shipping agentic AI capabilitiesthat has to hold up under real constraints.
				</p>
				<p>
					I specialize in full-stack data science — models, pipelines, and the interfaces that put
					them in front of people. The through-line is impact: AI that solves problems, not demos.
				</p>
				<p>
					Whether leading a team or debugging an inference stack, I approach the work the way the
					Marines trained me: clear intent, precise execution, own the outcome.
				</p>
			</div>
		</div>
	</section>

	<section class="container mx-auto px-4 pb-16">
		<div class="max-w-5xl">
			<div class="pixel-rule mb-8"></div>
			<h2 class="font-display text-2xl font-bold mb-8">Skills</h2>
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
				{skillsData.map((skillGroup) => (
					<div class="pixel-panel p-5">
						<h3 class="font-display text-base font-semibold mb-4 text-gold">{skillGroup.category}</h3>
						<div class="flex flex-wrap gap-2">
							{skillGroup.skills.map((skill) => (
								<span class="pixel-tag">{skill}</span>
							))}
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="container mx-auto px-4 pb-16">
		<div class="max-w-3xl">
			<div class="pixel-rule mb-8"></div>
			<h2 class="font-display text-2xl font-bold mb-3">Ranks earned</h2>
			<p class="text-sm text-muted-foreground mb-8 max-w-2xl">
				Enlisted E-1 through E-7, then commissioned — through Captain (O-3E). Marks are stylized for the site, not official insignia.
			</p>
			<RankTrail />
		</div>
	</section>

	<section class="container mx-auto px-4 pb-16">
		<div class="max-w-3xl">
			<h2 class="font-display text-2xl font-bold mb-8">Milestones</h2>
			<ol class="border-l-2 border-primary space-y-8 pl-6">
				{milestones.map((m) => (
					<li class="relative">
						<span class="absolute -left-[1.9rem] top-1 h-3 w-3 bg-primary border-2 border-background"></span>
						<span class="font-display text-primary font-semibold mr-2">{m.year}</span>
						<span class="text-muted-foreground">{m.text}</span>
					</li>
				))}
			</ol>
		</div>
	</section>

	<section class="container mx-auto px-4 pb-16">
		<div class="max-w-3xl border border-border border-l-4 border-l-gold bg-card p-8">
			<h2 class="font-display text-xl font-semibold mb-3 text-gold">Vision</h2>
			<p class="text-muted-foreground leading-relaxed">
				Help build a better world, one AI agent at a time — empowering people and organizations
				through systems that are useful, accountable, and built to last.
			</p>
		</div>
	</section>

	<section class="container mx-auto px-4 pb-16">
		<div class="max-w-3xl">
			<h2 class="font-display text-2xl font-bold mb-8">What I value</h2>
			<div class="border border-border divide-y divide-border">
				<div class="px-5 py-5">
					<h3 class="font-display text-lg font-semibold mb-2">Service and leadership</h3>
					<p class="text-sm text-muted-foreground">Military discipline and clear ownership applied to every team and project.</p>
				</div>
				<div class="px-5 py-5">
					<h3 class="font-display text-lg font-semibold mb-2">Data-driven systems</h3>
					<p class="text-sm text-muted-foreground">AI that earns its place by solving real problems under real constraints.</p>
				</div>
				<div class="px-5 py-5">
					<h3 class="font-display text-lg font-semibold mb-2">Academic rigor</h3>
					<p class="text-sm text-muted-foreground">Berkeley training as a foundation for careful, durable technical work.</p>
				</div>
			</div>
		</div>
	</section>

	<section class="container mx-auto px-4 pb-20">
		<div class="max-w-3xl">
			<div class="pixel-rule mb-8"></div>
			<h2 class="font-display text-2xl font-bold mb-3">Work together</h2>
			<p class="text-muted-foreground mb-6">Have a problem worth solving? Reach out.</p>
			<div class="flex flex-col sm:flex-row gap-3">
				<a href="/contact" class="btn btn-primary btn-lg cta-scan">Get In Touch</a>
				<a href="/projects" class="btn btn-outline btn-lg">View Projects</a>
			</div>
		</div>
	</section>
</MainLayout>
