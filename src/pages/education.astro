---
import MainLayout from '../layouts/main.astro';
import { getCollection } from 'astro:content';

const allEducation = (await getCollection('education')).map((entry) => entry.data);
const sortedEducation = [...allEducation].sort((a, b) => parseInt(b.gradDate) - parseInt(a.gradDate));
---

<MainLayout 
	title="Education — Lit Phansiri" 
	description="UC Berkeley MIDS and continuous technical training — Capt Lit Phansiri."
>
	<section class="hero-grid border-b border-border">
		<div class="container mx-auto px-4 py-20">
			<div class="max-w-3xl">
				<h1 class="font-display text-4xl md:text-6xl font-bold mb-4">Education</h1>
				<p class="text-lg text-muted-foreground max-w-2xl leading-relaxed">
					From UC Berkeley's Master of Information and Data Science program to specialized cyber training —
					continuous learning under real standards.
				</p>
			</div>
		</div>
	</section>

	<section class="container mx-auto px-4 py-16">
		<div class="max-w-3xl space-y-4">
			{sortedEducation.map((edu) => (
				<article class="pixel-panel p-6 md:p-8">
					<div class="flex flex-col sm:flex-row gap-5">
						<div class="shrink-0 h-16 w-16 border-2 border-gold bg-secondary flex items-center justify-center font-display text-xl font-bold text-gold">
							{edu.university.charAt(0)}
						</div>
						<div class="flex-1">
							<div class="flex flex-col md:flex-row md:items-start md:justify-between gap-2 mb-3">
								<div>
									<h2 class="font-display text-xl font-semibold text-primary mb-1">{edu.degree}</h2>
									<p class="font-medium">{edu.university}</p>
									<p class="text-sm text-muted-foreground">{edu.concentration}</p>
								</div>
								<p class="text-sm font-display text-gold shrink-0">{edu.gradDate}</p>
							</div>
							{edu.description && (
								<p class="text-muted-foreground mb-4 leading-relaxed">{edu.description}</p>
							)}
							{edu.link && (
								<a 
									href={edu.link} 
									target="_blank" 
									rel="noopener noreferrer"
									class="inline-flex items-center gap-2 text-sm text-primary hover:text-gold transition-colors"
								>
									Learn more
									<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
									</svg>
								</a>
							)}
						</div>
					</div>
				</article>
			))}
		</div>
	</section>

	<section class="container mx-auto px-4 pb-20">
		<div class="max-w-3xl border border-border bg-card p-8">
			<h2 class="font-display text-2xl font-bold mb-3">Continuous learning</h2>
			<p class="text-muted-foreground mb-8 leading-relaxed">
				Military training for discipline and strategy; academic programs for technical depth.
				The best education pairs theory with systems that have to work.
			</p>
			<div class="border border-border divide-y divide-border">
				<div class="px-4 py-4">
					<h3 class="font-display font-semibold mb-1">Goal-oriented</h3>
					<p class="text-sm text-muted-foreground">Every objective tied to a practical outcome.</p>
				</div>
				<div class="px-4 py-4">
					<h3 class="font-display font-semibold mb-1">Adaptive</h3>
					<p class="text-sm text-muted-foreground">Skills that keep pace with the stack and the threat.</p>
				</div>
				<div class="px-4 py-4">
					<h3 class="font-display font-semibold mb-1">Collaborative</h3>
					<p class="text-sm text-muted-foreground">Teach, share, and raise the standard around you.</p>
				</div>
			</div>
		</div>
	</section>
</MainLayout>
