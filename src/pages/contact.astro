---
import MainLayout from '../layouts/main.astro';
import { siteConfig } from '../lib/config';
---

<MainLayout 
	title={`Contact — ${siteConfig.author.name}`} 
	description="Connect with Capt Lit Phansiri on LinkedIn for AI collaboration and professional opportunities."
>
	<section class="hero-grid border-b border-border">
		<div class="container mx-auto px-4 py-20">
			<div class="max-w-3xl">
				<h1 class="font-display text-4xl md:text-6xl font-bold mb-4">Contact</h1>
				<p class="text-lg text-muted-foreground max-w-2xl leading-relaxed">
					Open to discussing AI systems, data science collaboration, and professional opportunities.
				</p>
			</div>
		</div>
	</section>

	<section class="container mx-auto px-4 py-16 pb-24">
		<div class="max-w-3xl border border-border bg-card p-8 md:p-10">
			<div class="flex items-center gap-3 mb-6">
				<span class="flex h-10 w-10 items-center justify-center border-2 border-primary text-primary font-display font-bold">
					LP
				</span>
				<div>
					<p class="font-display font-semibold">{siteConfig.author.name}</p>
					<p class="text-xs text-muted-foreground tracking-wide">Capt · O-3E · USMC</p>
				</div>
			</div>
			<h2 class="font-display text-2xl font-bold mb-3">Connect on LinkedIn</h2>
			<p class="text-muted-foreground mb-8 leading-relaxed max-w-xl">
				For privacy and professionalism, LinkedIn is the preferred channel.
				Verified professionals only — keep it clear and direct.
			</p>
			<a 
				href={siteConfig.social.linkedin} 
				target="_blank" 
				rel="noopener noreferrer"
				class="cta-scan inline-flex items-center gap-3 bg-primary text-primary-foreground border border-primary px-6 py-3 font-medium hover:bg-primary/90 transition-colors"
			>
				<svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
				</svg>
				Open LinkedIn
			</a>
		</div>
	</section>
</MainLayout>
