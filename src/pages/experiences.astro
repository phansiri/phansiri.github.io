---
import MainLayout from '../layouts/main.astro';
import { getCollection } from 'astro:content';

const experiences = (await getCollection('experiences'))
	.map((entry) => entry.data)
	.sort((a, b) => a.order - b.order);
---

<MainLayout 
	title="Experiences — Lit Phansiri" 
	description="Professional tour: Capt Lit Phansiri from Active Duty Marine Corps to full-stack data science."
>
	<section class="hero-grid border-b border-border">
		<div class="container mx-auto px-4 py-20">
			<div class="max-w-3xl">
				<h1 class="font-display text-4xl md:text-6xl font-bold mb-4">Experiences</h1>
				<p class="text-lg text-muted-foreground max-w-2xl leading-relaxed">
					From Active Duty Marine to data scientist — military command and technical delivery in one career.
				</p>
			</div>
		</div>
	</section>

	<section class="container mx-auto px-4 py-16">
		<div class="max-w-3xl space-y-4">
			{experiences.map((exp, index) => (
				<article class="pixel-panel p-6">
					<div class="flex flex-col md:flex-row md:items-start md:justify-between gap-2 mb-4">
						<div>
							<p class="text-xs tracking-widest uppercase text-gold mb-1">{String(exp.order).padStart(2, '0')}</p>
							<h2 class="font-display text-xl font-semibold text-primary mb-1">{exp.title}</h2>
							<p class="font-medium">{exp.company}</p>
						</div>
						<div class="text-sm text-muted-foreground md:text-right">
							<p>{exp.location}</p>
							<p class="text-foreground/80">{exp.period}</p>
						</div>
					</div>

					<p class="text-muted-foreground mb-4 leading-relaxed">{exp.description}</p>

					<div class="mb-4">
						<h3 class="font-display text-sm font-semibold mb-2 text-gold">Key achievements</h3>
						<ul class="space-y-1">
							{exp.achievements.map((achievement) => (
								<li class="flex items-start gap-2 text-sm text-muted-foreground">
									<span class="text-primary mt-0.5 shrink-0">▸</span>
									<span>{achievement}</span>
								</li>
							))}
						</ul>
					</div>

					<div class="flex flex-wrap gap-2">
						{exp.technologies.map((tech) => (
							<span class="pixel-tag">{tech}</span>
						))}
					</div>
				</article>
			))}
		</div>
	</section>

	<section class="container mx-auto px-4 pb-16">
		<div class="max-w-3xl">
			<div class="pixel-rule mb-8"></div>
			<h2 class="font-display text-2xl font-bold mb-6">Core competencies</h2>
			<div class="border border-border divide-y divide-border">
				<div class="px-5 py-5">
					<h3 class="font-display text-lg font-semibold mb-1">Data science</h3>
					<p class="text-sm text-muted-foreground">Statistical analysis, machine learning, and predictive systems.</p>
				</div>
				<div class="px-5 py-5">
					<h3 class="font-display text-lg font-semibold mb-1">Generative AI</h3>
					<p class="text-sm text-muted-foreground">Production LLM applications and agent systems under real constraints.</p>
				</div>
				<div class="px-5 py-5">
					<h3 class="font-display text-lg font-semibold mb-1">Leadership</h3>
					<p class="text-sm text-muted-foreground">Marine-trained command in high-pressure technical environments.</p>
				</div>
			</div>
		</div>
	</section>

	<section class="container mx-auto px-4 pb-20">
		<div class="max-w-3xl border border-border bg-card p-8">
			<h2 class="font-display text-2xl font-bold mb-3">Ready to collaborate</h2>
			<p class="text-muted-foreground mb-6">
				Military discipline, academic rigor, and systems work — let's discuss the mission.
			</p>
			<div class="flex flex-col sm:flex-row gap-3">
				<a href="/contact" class="btn btn-primary btn-lg cta-scan">Get In Touch</a>
				<a href="/projects" class="btn btn-outline btn-lg">View Projects</a>
			</div>
		</div>
	</section>
</MainLayout>
