---
import MainLayout from '../../layouts/main.astro';
import { getCollection } from 'astro:content';
import { getPaginatedPosts, calculateReadingTime, formatDate, groupPostsByCategory } from '../../lib/blog';

const POSTS_PER_PAGE = 6;
const currentPage = 1;

const paginationResult = await getPaginatedPosts({
  postsPerPage: POSTS_PER_PAGE,
  currentPage
});

const { posts, totalPosts, totalPages, startIndex, endIndex, paginationUrls } = paginationResult;

const allPosts = await getCollection('blog');
const publishedPosts = allPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const featuredPosts = publishedPosts.filter(post => post.data.featured).slice(0, 2);
const allCategories = [...new Set(publishedPosts.map(post => post.data.category))];
const postsByCategory = groupPostsByCategory(posts);
---

<MainLayout 
  title="Blog — Lit Phansiri" 
  description="Notes on AI systems, computer systems, and technology from a Marine Corps officer and data scientist."
>
  <section class="hero-grid border-b border-border">
    <div class="container mx-auto px-4 py-20">
      <div class="max-w-3xl">
        <h1 class="font-display text-4xl md:text-6xl font-bold mb-4">Blog</h1>
        <p class="text-lg text-muted-foreground max-w-2xl leading-relaxed">
          Deep dives into AI systems, computer systems, and the work of building things that have to hold up.
        </p>
      </div>
    </div>
  </section>

  <section class="container mx-auto px-4 py-8">
    <div class="max-w-4xl">
      <div class="border border-border bg-card p-4 md:p-5 mb-8">
        <div class="flex flex-col md:flex-row gap-3">
          <div class="flex-1 relative">
            <input 
              id="search-input"
              type="text" 
              placeholder="Search title, description, or tags..." 
              class="w-full pl-3 pr-3 py-2 border border-border bg-background focus:outline-none focus:ring-2 focus:ring-ring rounded-none"
            />
          </div>
          <select 
            id="category-filter"
            class="md:w-56 px-3 py-2 border border-border bg-background focus:outline-none focus:ring-2 focus:ring-ring rounded-none"
          >
            <option value="">All Categories</option>
            {allCategories.map(category => (
              <option value={category}>{category}</option>
            ))}
          </select>
          <select 
            id="sort-options"
            class="md:w-44 px-3 py-2 border border-border bg-background focus:outline-none focus:ring-2 focus:ring-ring rounded-none"
          >
            <option value="newest">Newest</option>
            <option value="oldest">Oldest</option>
            <option value="title">Title A–Z</option>
            <option value="reading-time">Reading time</option>
          </select>
        </div>
        <div id="search-results-info" class="mt-3 text-sm text-muted-foreground hidden">
          <span id="results-count">0</span> posts found
          <button id="clear-filters" type="button" class="ml-4 text-primary hover:text-gold">Clear filters</button>
        </div>
      </div>
    </div>
  </section>

  {featuredPosts.length > 0 && (
    <section class="container mx-auto px-4 pb-12">
      <div class="max-w-4xl">
        <h2 class="font-display text-xl font-bold mb-4 text-gold">Featured</h2>
        <div class="border border-border divide-y divide-border">
          {featuredPosts.map((post) => (
            <article class="group featured-post" data-category={post.data.category} data-title={post.data.title.toLowerCase()} data-tags={post.data.tags.join(' ').toLowerCase()}>
              <a href={`/blog/${post.id}`} class="block px-5 py-5 hover:bg-card transition-colors">
                <div class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground mb-2">
                  <span class="pixel-tag border-primary text-primary">{post.data.category}</span>
                  <span>{formatDate(post.data.publishDate)}</span>
                </div>
                <h3 class="font-display text-xl font-semibold mb-2 group-hover:text-primary transition-colors">
                  {post.data.title}
                </h3>
                <p class="text-sm text-muted-foreground mb-3 line-clamp-3">{post.data.description}</p>
                <div class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
                  <span>{post.data.readingTime || calculateReadingTime(post.body)} min</span>
                  {post.data.tags.slice(0, 3).map((tag) => (
                    <span class="pixel-tag">{tag}</span>
                  ))}
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="container mx-auto px-4 pb-16">
    <div class="max-w-4xl">
      <div class="pixel-rule mb-8"></div>
      <h2 class="font-display text-xl font-bold mb-6">All posts</h2>
      
      <div id="posts-container">
        {Object.keys(postsByCategory).length > 0 ? (
          Object.entries(postsByCategory).map(([category, categoryPosts]) => (
            <div class="mb-10 category-section" data-category={category}>
              <div class="flex items-baseline gap-3 mb-3">
                <h3 class="font-display text-lg font-semibold">{category}</h3>
                <span class="text-xs text-muted-foreground"><span class="category-count">{categoryPosts.length}</span></span>
              </div>
              
              <div class="border border-border divide-y divide-border">
                {categoryPosts.map((post) => (
                  <article class="group blog-post" data-category={post.data.category} data-title={post.data.title.toLowerCase()} data-tags={post.data.tags.join(' ').toLowerCase()} data-reading-time={post.data.readingTime || calculateReadingTime(post.body)}>
                    <a href={`/blog/${post.id}`} class="block px-5 py-5 hover:bg-card transition-colors">
                      <div class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground mb-2">
                        <span>{formatDate(post.data.publishDate)}</span>
                        <span>·</span>
                        <span>{post.data.readingTime || calculateReadingTime(post.body)} min</span>
                      </div>
                      <h4 class="font-display text-lg font-semibold mb-2 group-hover:text-primary transition-colors">
                        {post.data.title}
                      </h4>
                      <p class="text-sm text-muted-foreground mb-3 line-clamp-3">{post.data.description}</p>
                      <div class="flex flex-wrap gap-1">
                        {post.data.tags.slice(0, 3).map((tag) => (
                          <span class="pixel-tag">{tag}</span>
                        ))}
                      </div>
                    </a>
                  </article>
                ))}
              </div>
            </div>
          ))
        ) : (
          <p class="text-muted-foreground py-12">No posts found.</p>
        )}
      </div>
    </div>
  </section>

  {totalPages > 1 && (
    <section class="container mx-auto px-4 pb-20">
      <div class="max-w-4xl">
        <nav class="flex flex-wrap items-center gap-2" aria-label="Blog pagination">
          {paginationUrls.map((url) => (
            <a
              href={url.url}
              class={`px-4 py-2 text-sm font-medium border transition-colors ${
                url.current
                  ? 'bg-primary text-primary-foreground border-primary'
                  : 'bg-background border-border text-muted-foreground hover:border-primary hover:text-primary'
              }`}
              aria-current={url.current ? 'page' : undefined}
            >
              {url.label}
            </a>
          ))}
        </nav>
        <p class="mt-4 text-sm text-muted-foreground">
          Showing {startIndex + 1}–{Math.min(endIndex, totalPosts)} of {totalPosts}
        </p>
      </div>
    </section>
  )}
</MainLayout>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('search-input');
    const categoryFilter = document.getElementById('category-filter');
    const sortOptions = document.getElementById('sort-options');
    const searchResultsInfo = document.getElementById('search-results-info');
    const resultsCount = document.getElementById('results-count');
    const clearFilters = document.getElementById('clear-filters');
    
    const allPosts = document.querySelectorAll('.blog-post, .featured-post');
    const categorySections = document.querySelectorAll('.category-section');
    
    function filterAndSearch() {
      const searchTerm = searchInput.value.toLowerCase().trim();
      const selectedCategory = categoryFilter.value;
      const sortBy = sortOptions.value;
      
      let visiblePosts = [];
      let totalVisible = 0;
      
      allPosts.forEach(post => {
        const title = post.dataset.title || '';
        const tags = post.dataset.tags || '';
        const category = post.dataset.category || '';
        const description = post.querySelector('p')?.textContent?.toLowerCase() || '';
        
        const matchesSearch = !searchTerm || 
          title.includes(searchTerm) || 
          tags.includes(searchTerm) || 
          description.includes(searchTerm);
        
        const matchesCategory = !selectedCategory || category === selectedCategory;
        
        if (matchesSearch && matchesCategory) {
          post.style.display = 'block';
          visiblePosts.push(post);
          totalVisible++;
        } else {
          post.style.display = 'none';
        }
      });
      
      if (sortBy === 'title') {
        visiblePosts.sort((a, b) => {
          const titleA = a.querySelector('h3, h4')?.textContent || '';
          const titleB = b.querySelector('h3, h4')?.textContent || '';
          return titleA.localeCompare(titleB);
        });
      } else if (sortBy === 'reading-time') {
        visiblePosts.sort((a, b) => {
          const timeA = parseInt(a.dataset.readingTime || '0');
          const timeB = parseInt(b.dataset.readingTime || '0');
          return timeA - timeB;
        });
      }
      
      categorySections.forEach(section => {
        const postsInSection = section.querySelectorAll('.blog-post');
        let visibleInSection = 0;
        postsInSection.forEach(p => {
          if (p.style.display !== 'none') visibleInSection++;
        });
        const categoryCount = section.querySelector('.category-count');
        
        if (visibleInSection > 0) {
          section.style.display = 'block';
          if (categoryCount) categoryCount.textContent = String(visibleInSection);
        } else {
          section.style.display = 'none';
        }
      });
      
      if (searchTerm || selectedCategory) {
        searchResultsInfo.classList.remove('hidden');
        resultsCount.textContent = totalVisible;
      } else {
        searchResultsInfo.classList.add('hidden');
      }
    }
    
    searchInput.addEventListener('input', filterAndSearch);
    categoryFilter.addEventListener('change', filterAndSearch);
    sortOptions.addEventListener('change', filterAndSearch);
    
    clearFilters.addEventListener('click', function() {
      searchInput.value = '';
      categoryFilter.value = '';
      sortOptions.value = 'newest';
      filterAndSearch();
    });
  });
</script>
