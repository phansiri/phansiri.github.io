---
import MainLayout from '../../layouts/main.astro';
import { getCollection, render } from 'astro:content';
import { siteConfig, getFullUrl } from '../../lib/config';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter(p => p.id !== post.id && !p.data.draft)
  .filter(p => p.data.category === post.data.category || p.data.tags.some(tag => post.data.tags.includes(tag)))
  .slice(0, 3);

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  }).format(date);
}

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "author": {
    "@type": "Person",
    "name": post.data.author,
    "url": siteConfig.url
  },
  "publisher": {
    "@type": "Person",
    "name": post.data.author
  },
  "datePublished": post.data.publishDate.toISOString(),
  "dateModified": post.data.updatedDate?.toISOString() || post.data.publishDate.toISOString(),
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": getFullUrl(`/blog/${post.id}`)
  },
  "keywords": post.data.tags.join(', '),
  "articleSection": post.data.category,
  "wordCount": post.body.split(/\s+/).length
};
---

<MainLayout 
  title={`${post.data.title} — Lit Phansiri`}
  description={post.data.description}
  image={post.data.image}
  type="article"
  author={post.data.author}
  publishedTime={post.data.publishDate.toISOString()}
  modifiedTime={post.data.updatedDate?.toISOString() || post.data.publishDate.toISOString()}
  section={post.data.category}
  tags={post.data.tags}
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": siteConfig.url },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": getFullUrl("/blog") },
      { "@type": "ListItem", "position": 3, "name": post.data.title, "item": getFullUrl(`/blog/${post.id}`) }
    ]
  })} />
  
  <article class="container mx-auto px-4 py-16">
    <div class="max-w-3xl mx-auto">
      <nav class="mb-8 text-sm text-muted-foreground">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-primary transition-colors">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/blog" class="hover:text-primary transition-colors">Blog</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-foreground line-clamp-1">{post.data.title}</li>
        </ol>
      </nav>

      <header class="mb-10">
        <div class="flex flex-wrap items-center gap-2 mb-4">
          <span class="pixel-tag border-primary text-primary">{post.data.category}</span>
          {post.data.featured && (
            <span class="pixel-tag border-gold text-gold">Featured</span>
          )}
        </div>
        
        <h1 class="font-display text-4xl md:text-5xl font-bold mb-4 leading-tight">
          {post.data.title}
        </h1>
        
        <p class="text-lg text-muted-foreground mb-6 leading-relaxed">
          {post.data.description}
        </p>
        
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted-foreground border-y border-border py-3">
          <span>{post.data.author}</span>
          <span>{formatDate(post.data.publishDate)}</span>
          {post.data.updatedDate && (
            <span>Updated {formatDate(post.data.updatedDate)}</span>
          )}
          <span>{post.data.readingTime || Math.ceil(post.body.split(/\s+/).length / 200)} min read</span>
        </div>
      </header>

      <div class="flex flex-wrap gap-2 mb-10">
        {post.data.tags.map((tag) => (
          <span class="pixel-tag">#{tag}</span>
        ))}
      </div>

      {post.data.image && (
        <div class="mb-12 border border-border overflow-hidden">
          <img 
            src={post.data.image} 
            alt={post.data.imageAlt || post.data.title}
            class="w-full"
            loading="eager"
          />
        </div>
      )}

      <div class="prose prose-lg max-w-none">
        <Content />
      </div>
    </div>
  </article>

  {relatedPosts.length > 0 && (
    <section class="border-t border-border">
      <div class="container mx-auto px-4 py-16">
        <div class="max-w-3xl mx-auto">
          <h2 class="font-display text-2xl font-bold mb-6">Related</h2>
          <div class="border border-border divide-y divide-border">
            {relatedPosts.map((relatedPost) => (
              <article class="group">
                <a href={`/blog/${relatedPost.id}`} class="block px-5 py-5 hover:bg-card transition-colors">
                  <div class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground mb-2">
                    <span class="pixel-tag border-primary text-primary">{relatedPost.data.category}</span>
                    <span>{formatDate(relatedPost.data.publishDate)}</span>
                  </div>
                  <h3 class="font-display text-lg font-semibold mb-2 group-hover:text-primary transition-colors">
                    {relatedPost.data.title}
                  </h3>
                  <p class="text-sm text-muted-foreground line-clamp-2">{relatedPost.data.description}</p>
                </a>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="container mx-auto px-4 py-10">
    <div class="max-w-3xl mx-auto">
      <a href="/blog" class="btn btn-outline">← Back to Blog</a>
    </div>
  </section>
</MainLayout>

<style>
  :global(.prose pre) {
    background-color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 0;
    overflow-x: auto;
    padding: 1rem;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  :global(.prose pre.astro-code) {
    border-radius: 0 !important;
  }

  :global(.prose pre code) {
    background-color: transparent;
    padding: 0;
    border: none;
    color: inherit;
  }

  :global(.prose table) {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
    border: 1px solid var(--border);
  }

  :global(.prose thead) {
    background-color: var(--muted);
  }

  :global(.prose th),
  :global(.prose td) {
    padding: 0.75rem 1rem;
    text-align: left;
    border-bottom: 1px solid var(--border);
    color: var(--foreground);
  }

  :global(.prose tbody tr:hover) {
    background-color: color-mix(in srgb, var(--muted) 50%, transparent);
  }
</style>
