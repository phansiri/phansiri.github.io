---
import MainLayout from '../layouts/main.astro';
---

<MainLayout 
  title="Page Not Found — Lit Phansiri"
  description="The page you're looking for doesn't exist."
  noindex={true}
>
  <section class="hero-grid border-b border-border">
    <div class="container mx-auto px-4 py-24">
      <div class="max-w-2xl">
        <p class="font-display text-6xl md:text-8xl font-bold text-primary mb-4">404</p>
        <h1 class="font-display text-3xl md:text-4xl font-bold mb-4">Page not found</h1>
        <p class="text-muted-foreground mb-10 leading-relaxed">
          That route isn't on the map. Try one of these instead.
        </p>

        <ul class="border border-border divide-y divide-border mb-10">
          <li><a href="/" class="block px-4 py-3 hover:bg-card hover:text-primary transition-colors">Home</a></li>
          <li><a href="/blog" class="block px-4 py-3 hover:bg-card hover:text-primary transition-colors">Blog</a></li>
          <li><a href="/projects" class="block px-4 py-3 hover:bg-card hover:text-primary transition-colors">Projects</a></li>
          <li><a href="/about" class="block px-4 py-3 hover:bg-card hover:text-primary transition-colors">About</a></li>
        </ul>

        <div class="flex flex-wrap gap-2 mb-8">
          <a href="/blog" class="pixel-tag border-primary text-primary hover:bg-primary hover:text-primary-foreground transition-colors">AI/ML</a>
          <a href="/blog" class="pixel-tag hover:border-gold hover:text-gold transition-colors">Computer Systems</a>
          <a href="/blog" class="pixel-tag hover:border-gold hover:text-gold transition-colors">Technology</a>
        </div>

        <a href="/contact" class="btn btn-outline">Contact</a>
      </div>
    </div>
  </section>
</MainLayout>
