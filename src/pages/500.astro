---
import MainLayout from '../layouts/main.astro';
---

<MainLayout 
  title="Server Error — Lit Phansiri"
  description="Something went wrong on our end."
  noindex={true}
>
  <section class="hero-grid border-b border-border">
    <div class="container mx-auto px-4 py-24">
      <div class="max-w-2xl">
        <p class="font-display text-6xl md:text-8xl font-bold text-primary mb-4">500</p>
        <h1 class="font-display text-3xl md:text-4xl font-bold mb-4">Server error</h1>
        <p class="text-muted-foreground mb-8 leading-relaxed">
          Something broke on this end. Working the problem.
        </p>

        <div class="border border-border bg-card p-6 mb-8">
          <h2 class="font-display font-semibold mb-3">What you can do</h2>
          <ul class="text-sm text-muted-foreground space-y-2">
            <li class="flex gap-2"><span class="text-primary">▸</span> Refresh in a few minutes</li>
            <li class="flex gap-2"><span class="text-primary">▸</span> Clear cache and try again</li>
            <li class="flex gap-2"><span class="text-primary">▸</span> Try a different browser</li>
          </ul>
        </div>

        <div class="flex flex-col sm:flex-row gap-3">
          <button type="button" onclick="window.location.reload()" class="btn btn-primary btn-lg cta-scan">
            Refresh
          </button>
          <a href="/" class="btn btn-outline btn-lg">Go Home</a>
          <a href="/contact" class="btn btn-outline btn-lg">Report Issue</a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
